<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Rove.UI.ViewModels"
             mc:Ignorable="d"
             x:Class="Rove.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Panel Background="{DynamicResource OverlayDimBrush}">
        <Border Classes="overlaycard"
                Width="480" MaxHeight="420"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,72,0,0">
            <Grid RowDefinitions="Auto, *, Auto">
                <TextBlock Grid.Row="0" Classes="inputlabel" Text="Settings" Margin="0,0,0,6" />
                <ListBox x:Name="settings_list"
                         Grid.Row="1"
                         ItemsSource="{Binding Rows}"
                         SelectedIndex="{Binding SelectedIndex}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingsRow">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding Value}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                                <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2"
                           Text="j/k move · Enter/Space change · Esc close"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11"
                           Margin="2,6,2,0" />
            </Grid>
        </Border>
    </Panel>
</UserControl>
