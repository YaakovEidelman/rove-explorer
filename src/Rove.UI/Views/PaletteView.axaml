<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Rove.UI.ViewModels"
             xmlns:behaviors="using:Rove.UI.Behaviors"
             mc:Ignorable="d"
             x:Class="Rove.UI.Views.PaletteView"
             x:DataType="vm:PaletteViewModel">

    <!-- ── content only: the shared Quick Access card in MainWindow.axaml
         owns the dim background, the card, and the tab strip above this ── -->
    <Grid RowDefinitions="Auto, *">
        <TextBox Grid.Row="0"
                 Text="{Binding PaletteSearchText}"
                 PlaceholderText="{Binding Placeholder}"
                 behaviors:FocusOnTrue.Focus="{Binding IsPaletteOpen}"
                 Margin="0,0,0,8">
            <TextBox.InnerLeftContent>
                <Path Classes="overlayicon" Data="M10,1 L3,11 L8,11 L7,17 L15,7 L9,7 Z" />
            </TextBox.InnerLeftContent>
        </TextBox>
        <ListBox x:Name="palette_list"
                 Grid.Row="1"
                 ItemsSource="{Binding Items}"
                 SelectedIndex="{Binding SelectedIndex}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PaletteEntry">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding Hint}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Command.Def.Title}"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
