<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Rove.UI.ViewModels"
             xmlns:behaviors="using:Rove.UI.Behaviors"
             mc:Ignorable="d"
             x:Class="Rove.UI.Views.BookmarksView"
             x:DataType="vm:BookmarksViewModel">
    <Grid RowDefinitions="Auto, *, Auto">
        <TextBox Grid.Row="0"
                 Text="{Binding SearchText}"
                 PlaceholderText="go to a bookmark…"
                 behaviors:FocusOnTrue.Focus="{Binding IsOpen}"
                 Margin="0,0,0,8">
            <TextBox.InnerLeftContent>
                <Path Classes="overlayicon" Data="M2,1 L12,1 L12,16 L7,12 L2,16 Z" />
            </TextBox.InnerLeftContent>
        </TextBox>
        <ListBox x:Name="bookmark_list"
                 Grid.Row="1"
                 ItemsSource="{Binding Items}"
                 SelectedIndex="{Binding SelectedIndex}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:BookmarkRow">
                    <Panel>
                        <DockPanel IsVisible="{Binding IsAddNew}">
                            <TextBlock Text="+ Add a bookmark by path…"
                                       FontSize="13"
                                       IsVisible="{Binding !#bookmark_list.((vm:BookmarksViewModel)DataContext).InAddBookmark}" />
                            <TextBox x:Name="add_bookmark_box"
                                     Text="{Binding #bookmark_list.((vm:BookmarksViewModel)DataContext).AddBookmarkPath}"
                                     PlaceholderText="/path/to/somewhere"
                                     IsVisible="{Binding #bookmark_list.((vm:BookmarksViewModel)DataContext).InAddBookmark}"
                                     behaviors:FocusOnTrue.Focus="{Binding #bookmark_list.((vm:BookmarksViewModel)DataContext).InAddBookmark}" />
                            <Popup PlacementTarget="{Binding #add_bookmark_box}"
                                   Placement="BottomEdgeAlignedLeft"
                                   IsLightDismissEnabled="False"
                                   IsOpen="{Binding #bookmark_list.((vm:BookmarksViewModel)DataContext).Completions.IsOpen}"
                                   Width="{Binding #add_bookmark_box.Bounds.Width}">
                                <Border Classes="completions" MaxHeight="240">
                                    <ListBox ItemsSource="{Binding #bookmark_list.((vm:BookmarksViewModel)DataContext).Completions.Items}"
                                             SelectedIndex="{Binding #bookmark_list.((vm:BookmarksViewModel)DataContext).Completions.SelectedIndex}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PathCompletionEntry">
                                                <TextBlock Text="{Binding Display}" FontSize="13"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </DockPanel>
                        <DockPanel IsVisible="{Binding !IsAddNew}">
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Entry.Shortcut}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding Entry.Bookmark.Name}" FontSize="13" />
                                <TextBlock Text="{Binding Entry.Bookmark.Path}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Panel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="1"
                   Text="No bookmarks yet — press b on something to keep it."
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Margin="0,40,0,0"
                   VerticalAlignment="Top"
                   IsVisible="{Binding IsEmpty}" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="2,10,2,0"
                    IsVisible="{Binding !InAddBookmark}">
            <Border Classes="kbd"><TextBlock Text="Ctrl+N/P" /></Border>
            <TextBlock Classes="hint" Text="move" />
            <TextBlock Classes="hintsep" Text="·" />
            <Border Classes="kbd"><TextBlock Text="Ctrl+Shift+N/P" /></Border>
            <TextBlock Classes="hint" Text="reorder" />
            <TextBlock Classes="hintsep" Text="·" />
            <Border Classes="kbd"><TextBlock Text="Enter" /></Border>
            <TextBlock Classes="hint" Text="go / add" />
            <TextBlock Classes="hintsep" Text="·" />
            <Border Classes="kbd"><TextBlock Text="Ctrl+D" /></Border>
            <TextBlock Classes="hint" Text="forget" />
            <TextBlock Classes="hintsep" Text="·" />
            <Border Classes="kbd"><TextBlock Text="Esc" /></Border>
            <TextBlock Classes="hint" Text="close" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="2,10,2,0"
                    IsVisible="{Binding InAddBookmark}">
            <Border Classes="kbd"><TextBlock Text="Tab" /></Border>
            <TextBlock Classes="hint" Text="complete" />
            <TextBlock Classes="hintsep" Text="·" />
            <Border Classes="kbd"><TextBlock Text="Enter" /></Border>
            <TextBlock Classes="hint" Text="add bookmark" />
            <TextBlock Classes="hintsep" Text="·" />
            <Border Classes="kbd"><TextBlock Text="Esc" /></Border>
            <TextBlock Classes="hint" Text="cancel" />
        </StackPanel>
    </Grid>
</UserControl>
