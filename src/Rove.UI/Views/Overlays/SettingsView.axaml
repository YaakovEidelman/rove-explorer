<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Rove.UI.ViewModels"
             xmlns:behaviors="using:Rove.UI.Behaviors"
             mc:Ignorable="d"
             x:Class="Rove.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <Grid RowDefinitions="Auto, *, Auto">
        <ItemsControl Grid.Row="0" ItemsSource="{Binding SectionTabs}"
                      IsVisible="{Binding !InThemeEditor}"
                      Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SettingsSectionTab">
                    <Border Classes="settingstab" Classes.active="{Binding IsSelected}">
                        <TextBlock Text="{Binding Name}" FontSize="12" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ListBox x:Name="settings_list"
                 Grid.Row="1"
                 ItemsSource="{Binding Rows}"
                 SelectedIndex="{Binding SelectedIndex}"
                 IsVisible="{Binding !InThemeEditor}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SettingsRow">
                    <Border Classes="settingsrow">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Classes="toggletrack"
                                    Classes.on="{Binding IsOn}"
                                    IsVisible="{Binding IsToggle}">
                                <Ellipse Classes="togglethumb" />
                            </Border>
                            <Border DockPanel.Dock="Right" Classes="valuechip"
                                    IsVisible="{Binding !IsToggle}">
                                <TextBlock Text="{Binding Value}" />
                            </Border>
                            <TextBlock Text="{Binding Label}" FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ListBox x:Name="theme_list"
                 Grid.Row="1"
                 ItemsSource="{Binding ThemeRows}"
                 SelectedIndex="{Binding ThemeSelectedIndex}"
                 IsVisible="{Binding InThemeEditor}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ThemeEditorRow">
                    <Border Classes="settingsrow">
                        <DockPanel>
                            <TextBox DockPanel.Dock="Right" Width="140"
                                     Text="{Binding EditText}"
                                     IsVisible="{Binding IsEditing}"
                                     behaviors:FocusOnTrue.Focus="{Binding IsEditing}" />
                            <Border DockPanel.Dock="Right" Classes="valuechip"
                                    IsVisible="{Binding !IsEditing}">
                                <TextBlock Text="{Binding Value}" />
                            </Border>
                            <Ellipse DockPanel.Dock="Right" Width="14" Height="14"
                                     Fill="{Binding Swatch}"
                                     IsVisible="{Binding IsColor}"
                                     Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Label}" FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="2,10,2,0"
                    IsVisible="{Binding !InThemeEditor}">
            <Border Classes="kbd"><TextBlock Text="j/k" /></Border>
            <TextBlock Classes="hint" Text="move" />
            <TextBlock Classes="hintsep" Text="·" />
            <Border Classes="kbd"><TextBlock Text="h/l" /></Border>
            <TextBlock Classes="hint" Text="section" />
            <TextBlock Classes="hintsep" Text="·" />
            <Border Classes="kbd"><TextBlock Text="Enter/Space" /></Border>
            <TextBlock Classes="hint" Text="change" />
            <TextBlock Classes="hintsep" Text="·" />
            <Border Classes="kbd"><TextBlock Text="Tab" /></Border>
            <TextBlock Classes="hint" Text="switch tab" />
            <TextBlock Classes="hintsep" Text="·" />
            <Border Classes="kbd"><TextBlock Text="Esc" /></Border>
            <TextBlock Classes="hint" Text="close" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="2,10,2,0"
                    IsVisible="{Binding InThemeEditor}">
            <Border Classes="kbd"><TextBlock Text="j/k" /></Border>
            <TextBlock Classes="hint" Text="move" />
            <TextBlock Classes="hintsep" Text="·" />
            <Border Classes="kbd"><TextBlock Text="Enter" /></Border>
            <TextBlock Classes="hint" Text="edit / toggle" />
            <TextBlock Classes="hintsep" Text="·" />
            <Border Classes="kbd"><TextBlock Text="Esc" /></Border>
            <TextBlock Classes="hint" Text="back to settings" />
        </StackPanel>
    </Grid>
</UserControl>
