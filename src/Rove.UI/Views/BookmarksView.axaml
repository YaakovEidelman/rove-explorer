<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Rove.UI.ViewModels"
             xmlns:behaviors="using:Rove.UI.Behaviors"
             mc:Ignorable="d"
             x:Class="Rove.UI.Views.BookmarksView"
             x:DataType="vm:BookmarksViewModel">

    <Panel Background="{DynamicResource OverlayDimBrush}">
        <Border Classes="overlaycard"
                Width="480" MaxHeight="420"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,72,0,0">
            <Grid RowDefinitions="Auto, *, Auto">
                <TextBox Grid.Row="0"
                         Text="{Binding SearchText}"
                         PlaceholderText="go to a bookmark…"
                         behaviors:FocusOnTrue.Focus="{Binding IsOpen}"
                         Margin="0,0,0,6" />
                <ListBox x:Name="bookmark_list"
                         Grid.Row="1"
                         ItemsSource="{Binding Items}"
                         SelectedIndex="{Binding SelectedIndex}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:BookmarkEntry">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding Shortcut}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Bookmark.Name}" FontSize="13" />
                                    <TextBlock Text="{Binding Bookmark.Path}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1"
                           Text="No bookmarks yet — press b on something to keep it."
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,10"
                           IsVisible="{Binding IsEmpty}" />
                <TextBlock Grid.Row="2"
                           Text="Ctrl+N/Ctrl+P move · Enter go · Ctrl+D forget · Esc close"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11"
                           Margin="2,6,2,0" />
            </Grid>
        </Border>
    </Panel>
</UserControl>
